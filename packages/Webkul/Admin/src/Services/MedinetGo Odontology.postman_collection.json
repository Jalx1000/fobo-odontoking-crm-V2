  "item": [
    {
      "name": "LoginUserProv",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is JSON\", function () {",
              "    pm.response.to.be.json;",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "",
              "pm.test(\"Response has 'success' boolean\", function () {",
              "    pm.expect(jsonData).to.have.property(\"success\");",
              "    pm.expect(jsonData.success).to.be.a(\"boolean\");",
              "});",
              "",
              "pm.test(\"Response has 'data' and 'messageError' fields\", function () {",
              "    pm.expect(jsonData).to.have.property(\"data\");",
              "    pm.expect(jsonData).to.have.property(\"messageError\");",
              "});",
              "",
              "if (jsonData.success === true) {",
              "    pm.test(\"When success=true, data is an object\", function () {",
              "        pm.expect(jsonData.data).to.be.an(\"object\");",
              "    });",
              "",
              "    pm.test(\"data has token fields with expected types\", function () {",
              "        pm.expect(jsonData.data).to.have.property(\"accessToken\");",
              "        pm.expect(jsonData.data.accessToken).to.be.a(\"string\");",
              "",
              "        pm.expect(jsonData.data).to.have.property(\"refreshToken\");",
              "        pm.expect(jsonData.data.refreshToken).to.be.a(\"string\");",
              "",
              "        pm.expect(jsonData.data).to.have.property(\"expiresAt\");",
              "        // Typically ISO date-time string",
              "        pm.expect(jsonData.data.expiresAt).to.be.a(\"string\");",
              "    });",
              "",
              "    pm.test(\"data.webClientVtime is an array\", function () {",
              "        pm.expect(jsonData.data).to.have.property(\"webClientVtime\");",
              "        pm.expect(jsonData.data.webClientVtime).to.be.an(\"array\");",
              "    });",
              "",
              "    pm.test(\"webClientVtime items contain expected keys/types (where possible)\", function () {",
              "        const arr = jsonData.data.webClientVtime;",
              "        if (!Array.isArray(arr) || arr.length === 0) {",
              "            pm.expect.fail(\"webClientVtime is empty or not an array\");",
              "        }",
              "",
              "        const item = arr[0];",
              "        pm.expect(item).to.be.an(\"object\");",
              "",
              "        const expectedStringKeys = [",
              "            \"sClient\",",
              "            \"scliename\",",
              "            \"sOffice\",",
              "            \"sSexClien\",",
              "            \"sSexDescript\",",
              "            \"sType\",",
              "            \"sTypeProv\",",
              "            \"sEspecialidad\",",
              "            \"sSche_code\",",
              "            \"sIndBlockedPass\",",
              "            \"sExpirdateBlockedPass\",",
              "            \"sMessage\",",
              "            \"sExit\"",
              "        ];",
              "",
              "        expectedStringKeys.forEach(k => {",
              "            pm.expect(item).to.have.property(k);",
              "            pm.expect(item[k]).to.be.a(\"string\");",
              "        });",
              "",
              "        const expectedNumberKeys = [",
              "            \"nUsercode\",",
              "            \"nOffice\",",
              "            \"nProvider\",",
              "            \"nClinic\",",
              "            \"nLed_compan\",",
              "            \"nIntermed\",",
              "            \"nTypeProv\"",
              "        ];",
              "",
              "        expectedNumberKeys.forEach(k => {",
              "            pm.expect(item).to.have.property(k);",
              "            pm.expect(item[k]).to.be.a(\"number\");",
              "        });",
              "",
              "        const expectedDateStringKeys = [",
              "            \"dBirthdat\",",
              "            \"dInpDate\",",
              "            \"dExpirdateBlockedPass\"",
              "        ];",
              "",
              "        expectedDateStringKeys.forEach(k => {",
              "            pm.expect(item).to.have.property(k);",
              "            pm.expect(item[k]).to.be.a(\"string\");",
              "        });",
              "    });",
              "} else {",
              "    pm.test(\"When success=false, data may be null or object\", function () {",
              "        pm.expect(jsonData.data === null || typeof jsonData.data === 'object').to.be.true;",
              "    });",
              "}",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
